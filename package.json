{
  "name": "progress-character",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "start": "npm run build && wrangler dev --port 8787",
    "build": "vite build",
    "test": "node --test src/shared/*.test.js src/parser/*.test.js src/server/*.test.js",
    "db:migrate:local": "wrangler d1 migrations apply progress-character-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply progress-character-db --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "vite": "^6.4.1",
    "wrangler": "^4.50.0"
  }
}
